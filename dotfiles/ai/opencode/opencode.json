{
  "$schema": "https://opencode.ai/config.json",
  "model": "vercel/deepseek/deepseek-v4-pro-0813",
  "small_model": "vercel/anthropic/claude-haiku-5.5",
  "default_agent": "build",
  "experimental": {
    "subagent_depth": 2
  },
  "plugins": ["github:vercel/vercel-plugin"],
  "mcp": {
    "lucid": {
      "type": "remote",
      "url": "https://mcp.lucid.app/mcp"
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp"
    },
    "datadog": {
      "type": "remote",
      "url": "https://mcp.datadoghq.com/v1/mcp",
      "enabled": true
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com"
    }
  },
  "permission": {
    "external_directory": {
      "**/.config/opencode/docs/**": "allow"
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "vercel/deepseek/deepseek-v4-pro-0813",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "go build*": "allow",
          "go test*": "allow",
          "go vet*": "allow",
          "rg *": "ask",
          "gh pr view*": "allow",
          "gh pr diff*": "allow",
          "gh pr list*": "allow",
          "gh api --paginate*": "allow"
        },
        "pr_reply_comment": "ask"
      }
    },
    "plan": {
      "mode": "primary",
      "model": "vercel/anthropic/claude-opus-5.5",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "rg *": "ask"
        },
        "pr_reply_comment": "deny"
      }
    },
    "edit": {
      "mode": "primary",
      "model": "vercel/deepseek/deepseek-v4-pro-0813",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask"
        },
        "pr_reply_comment": "ask"
      }
    },
    "mechanic": {
      "description": "Runs the mechanics commands (/fix-pr-comments, /rebase, /check, /investigate, /next-linear-task) on DeepSeek V4 Flash: tool orchestration and small fixes; Jev classifies, designer decides, feature-builder takes substantial slices.",
      "mode": "primary",
      "model": "vercel/deepseek/deepseek-v4-flash-0731",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "go build*": "allow",
          "go test*": "allow",
          "go vet*": "allow",
          "rg *": "ask",
          "gh pr view*": "allow",
          "gh pr diff*": "allow",
          "gh pr list*": "allow",
          "gh api --paginate*": "allow"
        },
        "pr_reply_comment": "ask"
      }
    },
    "bulk": {
      "description": "Run defined bulk operations and utility commands on Haiku; makes no design or correctness decisions (those go to designer through a V4 Pro command).",
      "mode": "primary",
      "model": "vercel/anthropic/claude-haiku-5.5",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "go build*": "allow",
          "go test*": "allow",
          "go vet*": "allow",
          "rg *": "ask",
          "gh pr view*": "allow",
          "gh pr diff*": "allow",
          "gh pr list*": "allow",
          "gh api --paginate*": "allow"
        },
        "pr_reply_comment": "ask"
      }
    },
    "general": {
      "mode": "subagent",
      "model": "vercel/deepseek/deepseek-v4-pro-0813"
    },
    "explore": {
      "mode": "subagent",
      "model": "vercel/anthropic/claude-haiku-5.5",
      "tools": {
        "bash": false,
        "grep": false,
        "glob": false,
        "list": false,
        "read": true,
        "go_outline": true,
        "repo_grep": true,
        "write": false,
        "edit": false,
        "patch": false,
        "task": false,
        "webfetch": false,
        "go_doc": false,
        "tf_plan_summary": false
      },
      "prompt": "Gather repository context with repo_grep, go_outline and read. Do not use shell, grep or glob. Return concise file:line evidence. Excluded paths must stay with the primary agent."
    },
    "coordinator": {
      "description": "Interactive form of designer: resolves one bounded design or hard decision on Opus in the designer schema and hands execution back to V4 Pro build; never implements",
      "mode": "primary",
      "model": "vercel/anthropic/claude-opus-5.5",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "rg *": "ask"
        },
        "pr_reply_comment": "deny"
      }
    },
    "linear-planner": {
      "description": "Plans an area's pending work into Linear projects, milestones and issues for one team; grouping on the Opus work-modeler, publication only after explicit approval",
      "mode": "primary",
      "model": "vercel/deepseek/deepseek-v4-pro-0813",
      "permission": {
        "edit": {
          "*": "deny",
          "*linear-plan-*.md": "allow"
        },
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git log*": "allow",
          "git branch*": "allow"
        },
        "pr_reply_comment": "deny"
      }
    }
  },
  "compaction": {
    "auto": true
  }
}
